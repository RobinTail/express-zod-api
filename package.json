    "eslint-plugin-allowed-dependencies": "^2.2.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "openai": "^6.37.0",
    "prettier": "3.9.6",
    "tsdown": "^0.22.4",
    "typescript-eslint": "catalog:dev",
    "vitest": "^4.1.5"
