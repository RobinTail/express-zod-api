    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.3.0",
    "eslint-plugin-allowed-dependencies": "^3.1.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "openai": "^7.0.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "tsdown": "^0.22.4",
    "typescript-eslint": "catalog:dev",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@11.19.0+sha512.7881f3ed590d472c4a955e2b88b2121791116066dcc88cbca3849ec9b60f1bbaa6d2ccb221fa91da4e1c65bef2bcbe379365aea7ac539c7bf86dedc3a1b22dce"
