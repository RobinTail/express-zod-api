{
  "private": true,
  "type": "module",
  "scripts": {
    "start": "pnpm -F example start",
    "prebuild": "node tools/contributors.ts && node tools/license.ts",
    "build": "pnpm -r build",
    "pretest": "node tools/make-tests.ts",
    "test": "pnpm -r test",
    "bench": "pnpm -F express-zod-api bench",
    "lint": "oxlint --disable-nested-config && oxfmt --check",
    "mdfix": "oxfmt '*.md'",
    "precommit": "pnpm lint && pnpm build && pnpm test && git add *.md example/example.* LICENSE",
    "install_hooks": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.2",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint-plugin-allowed-dependencies": "^3.1.0",
    "husky": "^9.1.7",
    "openai": "^7.0.0",
    "oxfmt": "0.65.0",
    "oxlint": "^1.76.0",
    "oxlint-plugin-eslint": "^1.76.0",
    "tsdown": "^0.22.4",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
