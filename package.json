{
  "private": true,
  "type": "module",
  "scripts": {
    "start": "pnpm -F example start",
    "prebuild": "node tools/contributors.ts && node tools/license.ts",
    "build": "pnpm -r build",
    "pretest": "node tools/make-tests.ts",
    "test": "pnpm -r test",
    "bench": "pnpm -F express-zod-api bench",
    "lint": "oxlint --disable-nested-config && oxfmt --check",
    "mdfix": "oxfmt '*.md'",
    "precommit": "pnpm lint && pnpm build && pnpm test && git add *.md example/example.* LICENSE",
    "install_hooks": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.2",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint-plugin-allowed-dependencies": "^3.1.0",
    "husky": "^9.1.7",
    "openai": "^7.0.0",
    "oxfmt": "0.65.0",
    "oxlint": "^1.76.0",
    "oxlint-plugin-eslint": "^1.76.0",
    "tsdown": "^0.22.4",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@12.1.0+sha512.d9b8276d97f6ec86e49815877f91ee9f63cee61f2063b304e43b6dab8fa07ce8a9afd46d2facd39f921e6a9d06b3c75a81349c7b888c2d22886bae0229901037"
}
