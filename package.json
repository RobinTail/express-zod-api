{
  "private": true,
  "type": "module",
  "scripts": {
    "start": "pnpm -F example start",
    "prebuild": "node tools/contributors.ts && node tools/license.ts",
    "build": "pnpm -r build",
    "pretest": "node tools/make-tests.ts",
    "test": "pnpm -r test",
    "bench": "pnpm -F express-zod-api bench",
    "lint": "oxlint --disable-nested-config && oxfmt --check",
    "mdfix": "oxfmt '*.md'",
    "precommit": "pnpm lint && pnpm build && pnpm test && git add *.md example/example.* LICENSE",
    "install_hooks": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.2",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint-plugin-allowed-dependencies": "^3.1.0",
    "husky": "^9.1.7",
    "openai": "^7.0.0",
    "oxfmt": "0.64.0",
    "oxlint": "^1.76.0",
    "oxlint-plugin-eslint": "^1.76.0",
    "tsdown": "^0.22.4",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af"
}
