{
  "private": true,
  "type": "module",
  "scripts": {
    "start": "pnpm -F example start",
    "prebuild": "node tools/contributors.ts && node tools/license.ts",
    "build": "pnpm -r build",
    "pretest": "node tools/make-tests.ts",
    "test": "pnpm -r test",
    "bench": "pnpm -F express-zod-api bench",
    "lint": "oxlint --disable-nested-config && oxfmt --check",
    "mdfix": "oxfmt '*.md'",
    "precommit": "pnpm lint && pnpm build && pnpm test && git add *.md example/example.* LICENSE",
    "install_hooks": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.2",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint-plugin-allowed-dependencies": "^3.1.0",
    "husky": "^9.1.7",
    "openai": "^7.0.0",
    "oxfmt": "0.66.0",
    "oxlint": "^1.76.0",
    "oxlint-plugin-eslint": "^1.76.0",
    "tsdown": "^0.22.4",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.3.2+sha512.82f9035314646eea981adec85c711a21ab5f3b05659b3f9ce9d270cbb93e8a0f614da17922bae097902e2b860ee8eb6d5c1a7e89299a16877c0c243f36b8e15b"
}
